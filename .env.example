# Copy to .env.local and fill in real values.
# Never commit secrets.

OPENAI_API_KEY=

# V1 lead handoff (server-side SMTP via PulseTech Hostinger mailbox)
# SENDER = SMTP_USER / SMTP_FROM (PulseTech-owned mailbox)
# RECIPIENT = LEAD_NOTIFICATION_EMAIL (configurable destination)
LEAD_NOTIFICATION_EMAIL=pulsetechlabs1@gmail.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=leads@pulsetechlabs.com
SMTP_PASS=
SMTP_FROM=leads@pulsetechlabs.com

# Automated tests only — never send real SMTP when true.
# Production Customer AI must leave this unset/false.
# LEAD_HANDOFF_DRY_RUN=true

# Inbound voice (ElevenLabs + Twilio)
# Post-call HMAC secret (do not weaken). Also used if initiation requests include ElevenLabs-Signature.
ELEVENLABS_WEBHOOK_SECRET=
# Optional dedicated secret for conversation-initiation header auth (Bearer or x-elevenlabs-webhook-secret)
ELEVENLABS_INITIATION_WEBHOOK_SECRET=
# Required for shared public voice-demo handoff via ElevenLabs register-call API
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Twilio number → demo id. Replace later with one dedicated number per paying client.
# Example: {"+1XXXXXXXXXX":"texassolar"}
# Paying clients: assigned/ported business numbers route directly — NO access code.
INBOUND_VOICE_NUMBER_MAP=
# Current private Twilio test number mapped to the Texas Solar Professional TEST profile
# Do NOT put shared public demo numbers here.
TWILIO_INBOUND_TEST_NUMBER=
TWILIO_INBOUND_TEST_DEMO_ID=texassolar

# Shared public Twilio numbers for prospect voice demos (comma-separated or JSON array).
# Many simultaneous sessions share these numbers via short-lived access codes.
# Example: +15551234567,+15559876543
PULSETECH_VOICE_DEMO_NUMBERS=
# Public base URL used when validating Twilio signatures / Gather action URLs
# Example: https://your-app.vercel.app
PULSETECH_PUBLIC_BASE_URL=
# Set to 1 to show “Voice demo will be enabled shortly” even in production when no numbers are set
# PULSETECH_VOICE_DEMO_PREVIEW=1

PHONE_AGENT_LEAD_EMAIL=
PHONE_AGENT_ALERT_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Durable shared BusinessProfile store (required on Vercel).
# Local/dev can use .data/demos (gitignored). That filesystem is ephemeral on Vercel
# and is NOT production persistence. Do not claim owner updates are saved across
# deployments until this table + service role are configured.
# Table: public.business_profiles (
#   id text primary key,
#   profile jsonb not null,
#   updated_at timestamptz not null default now()
# )
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
